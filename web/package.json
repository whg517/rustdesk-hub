{
  "name": "rustdesk-hub-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --react-plugin --deny-warnings -A react/set-state-in-effect -D react/rules-of-hooks -D react/exhaustive-deps -D eslint/no-var -D eslint/prefer-const src vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxlint": "1.95.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  }
}
